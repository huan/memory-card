{
  "name": "memory-card",
  "version": "2.0.0",
  "description": "ES6 Map like Async API, with Multi-Backend Support for Web and Node.js.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/src/mod.d.ts",
      "browser": "./dist/esm/src/mod.js",
      "node": "./dist/esm/src/node/mod.js",
      "default": "./dist/esm/src/mod.js"
    },
    "./browser": {
      "types": "./dist/esm/src/mod.d.ts",
      "default": "./dist/esm/src/mod.js"
    },
    "./node": {
      "types": "./dist/esm/src/mod.d.ts",
      "default": "./dist/esm/src/node/mod.js"
    }
  },
  "types": "./dist/esm/src/mod.d.ts",
  "engines": {
    "node": ">=26",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc",
    "clean": "shx rm -fr dist/*",
    "dist": "npm run clean && npm run build",
    "lint": "npm run lint:biome && npm run lint:ts",
    "lint:biome": "biome lint src tests scripts",
    "lint:ts": "tsc --isolatedModules --noEmit",
    "test": "npm run lint && npm run test:unit && npm run test:unit:web",
    "test:unit": "node --test src tests/resolution-matrix.native.test.ts",
    "test:unit:web": "node --conditions=browser --test src/memory-card.test.ts src/memory-card.unsupported.test.ts",
    "test:unit:deno": "deno test --no-check --allow-read=.,/tmp --allow-write=.,/tmp --allow-env src",
    "test:unit:browser": "wtr --config web-test-runner.config.js",
    "test:browser": "npm run test:unit:browser",
    "test:pack": "bash -x scripts/npm-pack-testing.sh",
    "coverage": "npm run coverage:unit && npm run coverage:browser",
    "coverage:unit": "node --test --experimental-test-coverage src tests/resolution-matrix.native.test.ts",
    "coverage:browser": "wtr --config web-test-runner.config.js --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huan/memory-card.git"
  },
  "keywords": [
    "async",
    "map",
    "key",
    "value",
    "store",
    "wintertc",
    "browser",
    "localstorage"
  ],
  "author": "Huan LI <zixia@zixia.net>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/huan/memory-card/issues"
  },
  "homepage": "https://github.com/huan/memory-card#readme",
  "dependencies": {
    "async-map-like": "^1.0.2",
    "brolog": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/chai": "^5.2.3",
    "@types/node": "^26.0.0",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/test-runner": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.2",
    "chai": "^6.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "shx": "^0.3.4",
    "typescript": "^5.8.0"
  },
  "imports": {
    "#memory-card": {
      "browser": "./src/mod.ts",
      "default": "./src/node/mod.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
